# =============================================================
# Code2Carbon / CarbonTrack — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to Git.
# =============================================================

# Supabase Project URL (public, used in client JS)
SUPABASE_URL=your_supabase_project_url_here

# Supabase Anon (Public) Key — used for browser-side Supabase SDK
# This is a publishable key, NOT a secret.  However keep it in config
# so it can be rotated without editing every JS file.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Server-side only (Supabase Edge Function secrets) ---

# Google Gemini API Key — stored in Supabase Secrets, never in client code
GEMINI_API_KEY=your_gemini_api_key_here
