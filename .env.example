# ==============================================================================
# CarbonTrack Deployment Environment Configuration (.env.example)
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development or tooling.
# 2. For production deployments (Vercel, Netlify, Render, Docker):
#    Set these variables in your platform's Environment Variables settings.
# 3. Running 'npm run build' will automatically generate 'carbontrack/env.js'
#    from these environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND SUPABASE CONFIGURATION (Client-Facing / Publishable)
# ------------------------------------------------------------------------------
# Your Supabase Project API URL (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Your Supabase public 'anon' publishable key (Safe for browser / client-side)
SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# ------------------------------------------------------------------------------
# 2. BACKEND SUPABASE SECRETS (Server-Side Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Edge Function AI insights generator
# Set in Supabase via CLI: supabase secrets set GEMINI_API_KEY="AIzaSy..."
# Or in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Configured in Google Cloud Console & Supabase Dashboard)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Web Client ID in Google Cloud Console (APIs & Services -> Credentials)
# Then enter these credentials in Supabase Dashboard (Authentication -> Providers -> Google)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Supabase Authorized Redirect URI to enter in Google Cloud Console:
# https://<your-project-ref>.supabase.co/auth/v1/callback

# ------------------------------------------------------------------------------
# 4. DEPLOYMENT DOMAINS & REDIRECTS
# ------------------------------------------------------------------------------
# The production URL of your hosted site (e.g., https://carbontrack.org or https://your-app.vercel.app)
# Add this domain to:
# - Google Cloud Console: 'Authorised JavaScript origins'
# - Supabase Dashboard: Authentication -> URL Configuration -> Site URL & Additional Redirect URLs
SITE_URL="https://your-production-domain.com"
