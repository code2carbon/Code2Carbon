# ==========================================================================
# CarbonTrack Environment Configuration Example
# Copy this file to .env for local tooling or deployment workflows.
# NEVER commit your actual .env file with real credentials to GitHub.
# ==========================================================================

# 1. Supabase Project Configuration (Client-side publishable keys)
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# 2. Supabase Server-Side Secrets (NEVER expose to frontend clients)
# Set directly in Supabase CLI or Dashboard -> Project Settings -> Secrets
# Command: supabase secrets set GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"
