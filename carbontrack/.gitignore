# =============================================================
# CarbonTrack .gitignore
# =============================================================

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.production.local
.env.*.local

# --- Vercel ---
.vercel

# --- Node / npm (if ever added) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build Outputs ---
dist/
build/
out/

# --- Caches ---
.cache/
.parcel-cache/
.turbo/

# --- OS Files ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs ---
logs/
*.log

# --- Temporary Files ---
tmp/
temp/
